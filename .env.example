# Copiar a .env.local

# Backend Nest (lo usa el rewrite /api de next.config.ts, solo servidor)
BACKEND_URL=http://localhost:3000

# Base REST que usa el navegador. Por defecto "/api" (pasa por el rewrite).
# Para llamar al backend directo: http://localhost:3000/api (requiere CORS_ORIGIN en el back).
# NEXT_PUBLIC_API_URL=/api

# Socket.io (namespace /live) — conexión directa al backend
NEXT_PUBLIC_WS_URL=http://localhost:3000
